{
  "sentinel-policy-guard": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "read_file|view_file|multimodal_view_file|run_command|write_to_file|replace_file_content|write_file|edit_file|multi_replace_file_content|invoke_subagent|send_message|schedule|manage_subagents|manage_task",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh ../../src/hooks/run_hook_safe.sh ../../src/hooks/multi_harness_hook_adapter.py --event PreToolUse",
            "timeout": 15
          }
        ]
      }
    ]
  },
  "black-hat-completion-gate": {
    "enabled": true,
    "PostInvocation": [
      {
        "type": "command",
        "command": "/bin/sh ../../src/hooks/run_hook_safe.sh ../../src/hooks/multi_harness_hook_adapter.py --event PostInvocation",
        "timeout": 10
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/bin/sh ../../src/hooks/run_hook_safe.sh ../../src/hooks/multi_harness_hook_adapter.py --event Stop",
        "timeout": 15
      }
    ]
  }
}
