{
  "mcpServers": {
    "diagram_renderer": {
      "command": "python3",
      "disabled": false,
      "args": [
        "-B",
        "${PLUGIN_ROOT}/src/diagram_renderer/diagram_mcp_server.py"
      ],
      "env": {
        "PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "PLUGIN_DATA": "${PLUGIN_DATA}"
      },
      "_meta": {
        "antigravity/alwaysLoad": true
      }
    },
    "deep_research": {
      "command": "python3",
      "disabled": false,
      "args": [
        "-B",
        "${PLUGIN_ROOT}/src/mcp_deep_research.py",
        "--transport",
        "stdio"
      ],
      "env": {
        "PLUGIN_ROOT": "${PLUGIN_ROOT}",
        "PLUGIN_DATA": "${PLUGIN_DATA}"
      },
      "_meta": {
        "antigravity/alwaysLoad": true
      }
    }
  }
}
